# ========== UNITY PROJECT STRUCTURE ==========

# Ignore Unity-generated folders (safe to regenerate)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
ExportedObj/

# Ignore Unity Collaborate caches
.Collab/

# Cache server files
UnityCache/

# Scene/Asset backups
*.bak
*.backup

# Ignore crash reports and diagnostics
sysinfo.txt
*.dmp

# ========== ASSETS & METADATA ==========

# Only ignore .meta if asset is ignored
!/[Aa]ssets/**/*.meta

# Ignore Asset Store Tools if not used
# /Assets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin (safe to regenerate)
Assets/Plugins/Editor/JetBrains*

# ========== IDE & TOOLING FILES ==========

# VS Code
.vscode/

# Visual Studio & MonoDevelop
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.pdb
*.mdb

# JetBrains (Rider)
.idea/
.idea/**/
*.iml
*.ipr
*.iws

# Gradle & Android
.gradle/
*.apk
*.aar
local.properties

# iOS / Xcode
*.xcworkspace/
*.xcuserstate
*.xcuserdata/
*.xcconfig
*.pbxuser
*.mode1v3
*.mode2v3
*.xcscheme
*.xcodeproj/*
!*.xcodeproj/project.pbxproj

# ========== PACKAGE OUTPUTS & EXPORTS ==========

# Unity Packages
*.unitypackage

# Build artifacts
*.apk
*.aab
*.ipa
*.exe
*.dll
*.app
*.dmg
*.msi

# ========== ANALYTICS & CRASH TOOLS ==========

crashlytics-build.properties

# ========== SERVER / USER CONFIGS ==========

# Unity user settings
UserSettings/
ServerData/

# ========== CUSTOM PROJECT PATHS (from your original) ==========
.idea/.idea.G4G Client/
.idea/.idea.Match3LordsOfTheBoard/.idea/.gitignore
.idea/.idea.Match3LordsOfTheBoard/.idea/encodings.xml
.idea/.idea.Match3LordsOfTheBoard/.idea/indexLayout.xml
.idea/.idea.Match3LordsOfTheBoard/.idea/riderModule.iml
.idea/.idea.Match3LordsOfTheBoard/.idea/vcs.xml
UserSettings/Layouts/

